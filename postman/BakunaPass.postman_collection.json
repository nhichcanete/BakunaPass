{
  "info": {
    "_postman_id": "8b53cf23-f017-4280-bc35-cc4c1f90a570",
    "name": "BakunaPass SIA Integration Tests",
    "description": "Covers gateway readiness, JWT, requisitions, JSON/XML telemetry, SOAP mediation, stock, risk mashup, validation, and service integration. Set baseUrl to http://127.0.0.1:3000. Use a reviewer/admin account for approval and stock operations when JWT is enabled.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "username", "value": "" },
    { "key": "password", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "requisitionId", "value": "" },
    { "key": "pendingRequisitionId", "value": "" },
    { "key": "simulateTelemetryFailure", "value": "false" }
  ],
  "item": [
    {
      "name": "Optional JWT Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}" },
        "url": "{{baseUrl}}/api/v1/auth/token"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.response.code === 200) {",
            "  const result = pm.response.json();",
            "  pm.collectionVariables.set('accessToken', result.token);",
            "  pm.test('JWT issued with expected bearer type', () => pm.expect(result.tokenType).to.eql('Bearer'));",
            "} else {",
            "  pm.test('Local demo or unconfigured optional login', () => pm.expect([401, 503]).to.include(pm.response.code));",
            "}"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "1 - Requisition Service Health",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/requisitions/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Requisition service is up', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().service).to.eql('requisitions'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "2 - Telemetry Service Health",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/telemetry/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Telemetry service is up', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().service).to.eql('telemetry'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "3 - Read Telemetry as JSON",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/v1/telemetry/VAX-1001" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('JSON telemetry response', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(pm.response.json().safeRangeCelsius.min).to.eql(2); });"], "type": "text/javascript" } }]
    },
    {
      "name": "4 - Read Telemetry as XML",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/xml" }], "url": "{{baseUrl}}/api/v1/telemetry/VAX-1001" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('XML content negotiation', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/xml'); pm.expect(pm.response.text()).to.include('<coldChainStatus>OK</coldChainStatus>'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "5 - Ingest Telemetry as JSON",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vaccineId\":\"VAX-PM-JSON-01\",\"vaccineName\":\"Measles\",\"currentTempCelsius\":4.5,\"safeRangeCelsius\":{\"min\":2,\"max\":8},\"humidityPercent\":60,\"shipmentId\":\"SHIP-PM-JSON-01\"}" },
        "url": "{{baseUrl}}/api/v1/telemetry"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('JSON telemetry stored', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().coldChainStatus).to.eql('OK'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "6 - Ingest Telemetry as XML",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/xml" },
          { "key": "Accept", "value": "application/xml" }
        ],
        "body": { "mode": "raw", "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<vaccineBatch><vaccineId>VAX-PM-XML-01</vaccineId><vaccineName>BCG</vaccineName><currentTempCelsius>9</currentTempCelsius><safeRangeCelsius min=\"2\" max=\"8\" /><humidityPercent>65</humidityPercent></vaccineBatch>" },
        "url": "{{baseUrl}}/api/v1/telemetry"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('XML telemetry stored and breach calculated', () => { pm.response.to.have.status(201); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/xml'); pm.expect(pm.response.text()).to.include('<coldChainStatus>BREACH</coldChainStatus>'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "7 - Missing Required Telemetry Field",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vaccineId\":\"VAX-INCOMPLETE\"}" },
        "url": "{{baseUrl}}/api/v1/telemetry"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Missing field is a structured 400', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.eql('MISSING_REQUIRED_FIELD'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "8 - Malformed JSON",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vaccineId\":}" },
        "url": "{{baseUrl}}/api/v1/telemetry"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Malformed JSON is rejected', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.eql('MALFORMED_PAYLOAD'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "9 - Malformed XML",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/xml" }],
        "body": { "mode": "raw", "raw": "<vaccineBatch><vaccineId>VAX-BAD</vaccineBatch>" },
        "url": "{{baseUrl}}/api/v1/telemetry"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Malformed XML is rejected', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.eql('MALFORMED_PAYLOAD'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "10 - Unsupported Content-Type",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "text/plain" }],
        "body": { "mode": "raw", "raw": "not JSON or XML" },
        "url": "{{baseUrl}}/api/v1/telemetry"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unsupported media type is rejected', () => { pm.response.to.have.status(415); pm.expect(pm.response.json().error).to.eql('UNSUPPORTED_MEDIA_TYPE'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "11 - Unknown Batch",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/telemetry/VAX-9999" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unknown batch returns 404', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error).to.eql('RESOURCE_NOT_FOUND'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "12 - Approve Requisition Using JSON Telemetry",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"clinicId\":\"RHU-0101\",\"vaccineType\":\"Pentavalent (DPT-HepB-Hib)\",\"quantity\":50,\"vaccineId\":\"VAX-1001\",\"telemetryFormat\":\"json\"}" },
        "url": "{{baseUrl}}/api/v1/requisitions"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Service A approves only a clear matching batch', () => { pm.response.to.have.status(201); const result = pm.response.json(); pm.expect(result.status).to.eql('APPROVED'); pm.collectionVariables.set('requisitionId', result.id); });"], "type": "text/javascript" } }]
    },
    {
      "name": "13 - Approve Requisition Using XML Telemetry",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"clinicId\":\"RHU-0101\",\"vaccineType\":\"BCG\",\"quantity\":20,\"vaccineId\":\"VAX-1003\",\"telemetryFormat\":\"xml\"}" },
        "url": "{{baseUrl}}/api/v1/requisitions"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Service A deserializes XML telemetry and approves', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('APPROVED'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "14 - Reject Requisition on Cold-Chain Breach",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"clinicId\":\"CLN-014\",\"vaccineType\":\"Measles\",\"quantity\":12,\"vaccineId\":\"VAX-1002\"}" },
        "url": "{{baseUrl}}/api/v1/requisitions"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('A breached batch is rejected with evidence', () => { pm.response.to.have.status(409); const result = pm.response.json(); pm.expect(result.error).to.eql('COLD_CHAIN_BREACH'); pm.expect(result.details.requisition.status).to.eql('REJECTED'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "15 - Reject Unknown Assigned Batch",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"clinicId\":\"CLN-014\",\"vaccineType\":\"Measles\",\"quantity\":12,\"vaccineId\":\"VAX-9999\"}" },
        "url": "{{baseUrl}}/api/v1/requisitions"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unknown batch does not create a requisition', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error).to.eql('RESOURCE_NOT_FOUND'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "16 - Failed Service-to-Service Request (Optional)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"clinicId\":\"RHU-0101\",\"vaccineType\":\"Pentavalent (DPT-HepB-Hib)\",\"quantity\":50,\"vaccineId\":\"VAX-1001\"}" },
        "url": "{{baseUrl}}/api/v1/requisitions"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (pm.collectionVariables.get('simulateTelemetryFailure') !== 'true') {",
              "  pm.execution.skipRequest();",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unavailable telemetry fails closed', () => {",
              "  pm.response.to.have.status(503);",
              "  pm.expect(pm.response.json().error).to.eql('SERVICE_UNAVAILABLE');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "17 - Gateway Readiness",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/ready" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('All downstream services are ready', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().services).to.have.length(4); });"], "type": "text/javascript" } }]
    },
    {
      "name": "18 - Legacy HIS WSDL Through Adapter",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/stock/wsdl" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('SOAP WSDL is mediated through the REST adapter', () => { pm.response.to.have.status(200); pm.expect(pm.response.text()).to.include('LegacyInventorySoapBinding'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "19 - Read Legacy Warehouse Inventory",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/stock/warehouse/WAREHOUSE-MNL" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('SOAP inventory is transformed to JSON', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().items).to.have.length(3); });"], "type": "text/javascript" } }]
    },
    {
      "name": "20 - Combined Shipment Risk Assessment",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/risk-assessment/shipment/SHIP-1001" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Mashup reports source statuses and an explainable result', () => { pm.response.to.have.status(200); const result = pm.response.json(); pm.expect(result.sources).to.have.property('telemetry'); pm.expect(result.sources).to.have.property('legacyInventory'); pm.expect(result.sources).to.have.property('weather'); pm.expect(result.assessment).to.have.property('reasons'); });"], "type": "text/javascript" } }]
    },
    {
      "name": "21 - Create Pending Requisition for Review",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"clinicId\":\"RHU-0101\",\"vaccineType\":\"BCG\",\"quantity\":10}" },
        "url": "{{baseUrl}}/api/v1/requisitions"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Pending request is created without a batch', () => { pm.response.to.have.status(201); const result = pm.response.json(); pm.expect(result.status).to.eql('PENDING'); pm.collectionVariables.set('pendingRequisitionId', result.id); });"], "type": "text/javascript" } }]
    },
    {
      "name": "22 - Assign and Verify Batch During Approval",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"status\":\"APPROVED\",\"vaccineId\":\"VAX-1003\"}" },
        "url": "{{baseUrl}}/api/v1/requisitions/{{pendingRequisitionId}}/status"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reviewer assigns a matching safe batch before approval', () => { pm.response.to.have.status(200); const result = pm.response.json(); pm.expect(result.status).to.eql('APPROVED'); pm.expect(result.vaccineId).to.eql('VAX-1003'); });"], "type": "text/javascript" } }]
    }
  ]
}
