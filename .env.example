PORT=3000
HOST=127.0.0.1
SERVICE_HOST=127.0.0.1
REQUISITION_SERVICE_PORT=5001
TELEMETRY_SERVICE_PORT=5002
LEGACY_ADAPTER_PORT=5003
LEGACY_SOAP_PORT=5004
MASHUP_SERVICE_PORT=5005
DATABASE_PATH=./data/bakunapass.sqlite
# Optional upstream override for simulating the requisition service's telemetry outage.
REQUISITION_TELEMETRY_URL=

# Gateway authentication. Required before exposing the service outside localhost.
# Generate a unique random secret and configure at least one trusted admin plus role accounts through your secret manager.
# For local role walkthrough accounts only, run `npm run seed:accounts`; never use generated local credentials in production.
JWT_SECRET=
API_USERS=
API_RATE_LIMIT=120
CORS_ORIGIN=

# Notification protection
# Optional extra bearer-token check. With JWT enabled, notification access still requires the health_worker role.
# Without JWT, a blank token limits notification requests to the local machine.
NOTIFICATION_API_TOKEN=

# Email delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM=

# Optional SMS delivery for resident follow-up notifications (not used for sign-in or MFA).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=